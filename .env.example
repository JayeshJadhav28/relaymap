# RelayMap environment. Copy to .env.local and fill in your own values.
# Never commit real credentials. The synthetic demo runs without any of these.
# See documentation/production/CONFIGURATION.md in a local development checkout.

# ---------------------------------------------------------------------------
# Firebase Authentication (the only end-user identity provider)
# Firebase console -> Project settings -> General -> Your apps -> Web app.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Firebase Admin service account. Server-only. Paste the private key with
# literal \n escapes, or point GOOGLE_APPLICATION_CREDENTIALS at a JSON file.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# ---------------------------------------------------------------------------
# Supabase (PostgreSQL, PostgREST, Storage)
# The publishable key is browser-safe. Requests carry the Firebase ID token,
# configured as third-party auth in Supabase, so row-level security applies.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only key for operational tooling (migrations, bucket setup). It is
# never used to answer a user request and never bypasses RLS.
SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Demo switch
# ---------------------------------------------------------------------------
# The synthetic demo is always available unless this is set to "false".
# It is an isolated in-memory store and never reads or writes real rows.
# RELAY_DEMO_MODE=false
